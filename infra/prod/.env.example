# Production settings (CLAUDE.md section 14). Copy to ".env" on the server and fill in EVERY value.
# ".env" is git-ignored. Never commit real values. Use a secret store or an encrypted backup for the keys.
# Where a value must be generated, the command is given; run it on a trusted machine.

# ---- database: AWS RDS PostgreSQL 16 --------------------------------------------------------------------------------
# The database and its five schemas (auth, cases, verification, documents, reports, modulith) are created by
# infra/local/postgres/init/01-create-schemas.sql (run it once against RDS as the master user).
DB_URL=jdbc:postgresql://YOUR-RDS-ENDPOINT:5432/nexlyn_bgv?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ---- files: AWS S3 (Mumbai) ------------------------------------------------------------------------------------------
# Private bucket, versioning on, default encryption on. Leave the keys empty to use the machine's IAM role (best).
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SSE=true

# ---- token signing (login sessions) ------------------------------------------------------------------------------------
# JWT_PRIVATE_KEY: an RSA private key in PEM form written on ONE line with the line breaks as \n.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | awk 'NF {printf "%s\\n", $0}'
# JWT_KEY_ID: any short name for this key, for example 2026-09. Change it when the key is replaced.
JWT_PRIVATE_KEY=
JWT_KEY_ID=
# Leave empty except while replacing the key (docs/runbooks/key-rotation.md).
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY=

# ---- encryption keys (base64 of 32 random bytes) -----------------------------------------------------------------------
#   openssl rand -base64 32
# TOTP_ENCRYPTION_KEY protects the two-step-login secrets.
# PII_ENCRYPTION_KEY protects stored Aadhaar / PAN / UAN numbers. LOSING IT MAKES THEM UNREADABLE FOREVER:
# keep an offline, encrypted copy somewhere safe and separate from the server (see docs/runbooks/key-management.md).
TOTP_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=

# ---- the site ---------------------------------------------------------------------------------------------------------------
# Exactly the address people type, with https and no trailing slash. It is the only origin the API accepts.
FRONTEND_ORIGIN=https://nexlyn-bgv-app.nexlynservices.com
# Folder holding fullchain.pem and privkey.pem readable by the proxy (uid 101). certbot-deploy-hook.sh fills it
# from /etc/letsencrypt/live/nexlyn-bgv-app.nexlynservices.com; do not point this at the Let's Encrypt folder directly (README).
TLS_CERT_DIR=./certs
ACME_WEBROOT=./acme

# ---- the first administrator (first start only) ---------------------------------------------------------------------
# Created once, only when no administrator exists yet. The password must meet the policy (12+ characters,
# 3 of 4 character kinds, not a common password). Sign in, set up two-step login, then REMOVE BOTH LINES.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# ---- tuning ---------------------------------------------------------------------------------------------------------------
REPORT_MAX_CONCURRENT_RENDERS=2
# Optional error tracking.
SENTRY_DSN=

# Pre-built images (leave as they are to build on the server).
BACKEND_IMAGE=nexlyn-bgv-backend:latest
FRONTEND_IMAGE=nexlyn-bgv-frontend:latest
