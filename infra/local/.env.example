# Copy to .env in this directory before running docker compose.

DB_NAME=nexlyn_bgv
DB_USERNAME=nexlyn
DB_PASSWORD=nexlyn_dev_password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
S3_BUCKET=nexlyn-bgv

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PORT=5173
BACKEND_PORT=8080

# First SUPER_ADMIN, created once on first start when no admin exists. Leave blank to skip.
# The password must meet the policy (12+ chars, 3 of: upper/lower/digit/symbol, not a common password).
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Token signing and 2FA-secret encryption keys. scripts/local-up.sh generates local ones into
# your (git-ignored) .env on first run - leave these blank here. Never commit real keys.
JWT_PRIVATE_KEY=
JWT_KEY_ID=
TOTP_ENCRYPTION_KEY=
