<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.nexlyn.bgv</groupId>
  <artifactId>bgv-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Nexlyn BGV Platform - Parent</name>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <spring-modulith.version>1.2.5</spring-modulith.version>
  </properties>

  <modules>
    <module>bgv-common</module>
    <module>modules/auth</module>
    <module>modules/cases</module>
    <module>modules/verification</module>
    <module>modules/documents</module>
    <module>modules/reports</module>
    <module>bgv-app</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.nexlyn.bgv</groupId>
        <artifactId>bgv-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nexlyn.bgv</groupId>
        <artifactId>bgv-auth</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nexlyn.bgv</groupId>
        <artifactId>bgv-cases</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nexlyn.bgv</groupId>
        <artifactId>bgv-verification</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nexlyn.bgv</groupId>
        <artifactId>bgv-documents</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nexlyn.bgv</groupId>
        <artifactId>bgv-reports</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
